  "dialogueDefinitions": [
    {
      "definitionId": "5040b419-9f95-44f3-8d25-bcc6d95d8b29",
      "displayName": "Dialogue 1",
      "startNodeId": "3f5d230f-fa3b-4888-991d-c79b2fdd5c64",
      "nodes": [
        {
          "nodeId": "3f5d230f-fa3b-4888-991d-c79b2fdd5c64",
          "displayName": "Hello",
          "speakerId": "42670c12-cecb-4484-944b-0697935173f9",
          "text": "Hello! I'm the Station Manager how can I help?",
          "next": [
            {
              "targetNodeId": "b057fb78-3f59-4fd2-8934-40eb401e28a3"
            }
          ],
          "graphPosition": {
            "x": 80,
            "y": 80
          }
        },
        {
          "nodeId": "b057fb78-3f59-4fd2-8934-40eb401e28a3",
          "displayName": "Introduction",
          "speakerId": "e095b3b2-3351-403a-abe1-88861fa489ad",
          "text": "I'm looking for my luggage. Where do we pick it up?",
          "next": [
            {
              "targetNodeId": "ff0b5fd6-5ac2-4ad9-8d48-11cd1ade6e45"
            }
          ],
          "graphPosition": {
            "x": 383.67789462988367,
            "y": 95.1273687954072
          }
        },
        {
          "nodeId": "ff0b5fd6-5ac2-4ad9-8d48-11cd1ade6e45",
          "displayName": "Luggage Huh",
          "speakerId": "42670c12-cecb-4484-944b-0697935173f9",
          "text": "Luggage is unloaded here at the dock. It should be over there. Good luck to ya. I 've got a schedule to maintain you see?",
          "next": [],
          "graphPosition": {
            "x": 648.6666666666666,
            "y": 121.12736879540721
          }
        }
      ],
      "interactionBinding": {
        "npcDefinitionId": null
      }
    },
    {
      "definitionId": "d728d566-1d68-49bf-8589-fafae61b3ea9",
      "displayName": "Talky talky",
      "startNodeId": "c1254d95-5356-4fa7-ad06-8855c429c620",
      "nodes": [
        {
          "nodeId": "c1254d95-5356-4fa7-ad06-8855c429c620",
          "displayName": "Start",
          "text": "Hello!",
          "next": [],
          "graphPosition": {
            "x": 80,
            "y": 80
          }
        }
      ],
      "interactionBinding": {
