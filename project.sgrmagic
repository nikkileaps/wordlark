            "description": "Battery consumed by the spell."
          },
          {
            "id": "chaosBase",
            "type": "number",
            "required": true,
            "default": 0,
            "description": "Base chaos chance from 0 to 100."
          },
          {
            "id": "resonanceCost",
            "type": "number",
            "required": false,
            "default": 0,
            "description": "Resonance consumed by the spell."
          }
        ],
        "cost": "caster.battery >= self.batteryCost && caster.resonance >= self.resonanceCost",
        "acceptsTarget": false,
        "onCast": [
          {
            "op": "consume",
            "target": "caster.battery",
            "amount": "self.batteryCost"
          },
          {
            "op": "consume",
            "target": "caster.resonance",
            "amount": "self.resonanceCost"
          },
          {
            "op": "branch",
            "condition": "roll(1d100) <= clamp(self.chaosBase - caster.resonance * 0.8, 0, 100)",
            "then": [
              {
                "op": "emit",
                "kind": "spell-chaos"
              },
              {
                "op": "set",
                "target": "caster.resonance",
                "value": "0"
              }
            ],
            "else": [
              {
                "op": "emit",
                "kind": "spell-success"
              }
            ]
          }
        ]
      }
    ]
  },
