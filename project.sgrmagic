  "dialogueDefinitions": [
    {
      "definitionId": "5040b419-9f95-44f3-8d25-bcc6d95d8b29",
      "displayName": "Welcome from Horace",
      "startNodeId": "3f5d230f-fa3b-4888-991d-c79b2fdd5c64",
      "nodes": [
        {
          "nodeId": "3f5d230f-fa3b-4888-991d-c79b2fdd5c64",
          "displayName": "Hello",
          "speakerId": "42670c12-cecb-4484-944b-0697935173f9",
          "text": "Welcome to Wordlark Hollow!",
          "intent": {
            "mustConveyFacts": [
              "The speaker is the Station Manager. He wants to know if the player needs help."
            ],
            "beat": "friendly greeting",
            "voiceNote": "warm but busy"
          },
          "next": [
            {
              "targetNodeId": "ff0b5fd6-5ac2-4ad9-8d48-11cd1ade6e45"
            }
          ],
          "graphPosition": {
            "x": 191.27011969837133,
            "y": 88.79101774964607
          }
        },
        {
          "nodeId": "ff0b5fd6-5ac2-4ad9-8d48-11cd1ade6e45",
          "displayName": "I am Horace",
          "speakerId": "42670c12-cecb-4484-944b-0697935173f9",
          "text": "I'm Horace Pennyfeather, Station Manager, and you must be Mim! Your Aunt Eloise is expecting you at the resort. If you need anything just hollar.",
          "next": [
            {
              "targetNodeId": "5b3bed66-fc34-40fd-92ac-d4b1baecd63a"
            }
          ],
          "graphPosition": {
            "x": 481.3960783921928,
            "y": 64.97051803353767
          }
        },
        {
          "nodeId": "5b3bed66-fc34-40fd-92ac-d4b1baecd63a",
          "displayName": "Thanks",
          "speakerId": "e095b3b2-3351-403a-abe1-88861fa489ad",
          "text": "Thanks! Can you tell me where I can find my suitcase?",
          "next": [
            {
              "targetNodeId": "5015ca7d-be4f-47be-b32d-b4838495dbf4"
            }
          ],
          "graphPosition": {
            "x": 851.3163514339238,
            "y": 71.71374263470446
          }
        },
        {
          "nodeId": "5015ca7d-be4f-47be-b32d-b4838495dbf4",
          "displayName": "Node 4",
          "speakerId": "42670c12-cecb-4484-944b-0697935173f9",
          "text": "Usually they're here waiting for you, but there seems to be some irregularity today. It's been a most unusual. You may want to check up at the station while I look into it. If they don't have it up there then come and find me.",
          "next": [],
          "graphPosition": {
            "x": 1243.9967505132,
            "y": 64.51134867114399
          }
        }
      ],
      "groups": [],
      "interactionBinding": {
        "npcDefinitionId": "42670c12-cecb-4484-944b-0697935173f9"
      }
    },
    {
      "definitionId": "d728d566-1d68-49bf-8589-fafae61b3ea9",
      "displayName": "Talky talky",
      "startNodeId": "c1254d95-5356-4fa7-ad06-8855c429c620",
      "nodes": [
        {
          "nodeId": "c1254d95-5356-4fa7-ad06-8855c429c620",
          "displayName": "Start",
          "text": "Hello!",
          "next": [],
          "graphPosition": {
            "x": 80,
            "y": 80
          }
        }
      ],
      "groups": [],
      "interactionBinding": {
        "npcDefinitionId": "42670c12-cecb-4484-944b-0697935173f9"
      }
    },
    {
      "definitionId": "de62f5af-687c-48e6-b9c3-ee063670ab95",
      "displayName": "Dialogue 3",
      "startNodeId": "ae791958-15a0-443e-858a-d37c0b2124e8",
      "nodes": [
        {
          "nodeId": "ae791958-15a0-443e-858a-d37c0b2124e8",
          "displayName": "Bo - Luggage Mess",
          "speakerId": "66013347-dc94-4518-898b-9dfd22ac7ced",
          "text": "Yeah ... baggage claim is a bit of a mess today not sure what happened. ",
          "intent": {
            "mustConveyFacts": [
              "Baggage claim is chaotic today."
            ],
            "beat": "impatient",
            "voiceNote": "warm but busy"
          },
          "next": [
            {
              "targetNodeId": "7699e27d-db70-41de-b6b3-12d3b276dc13"
            }
          ],
          "graphPosition": {
            "x": 80,
            "y": 80
          }
        },
        {
          "nodeId": "7699e27d-db70-41de-b6b3-12d3b276dc13",
          "displayName": "Upset Lady",
          "speakerId": "66013347-dc94-4518-898b-9dfd22ac7ced",
          "text": "I think that lady is pretty upset though.",
          "intent": {
            "mustConveyFacts": [
              "Lady at dock is upset."
            ],
            "beat": "dry humor",
            "voiceNote": "warm dry humor"
          },
          "next": [],
          "graphPosition": {
            "x": 346,
            "y": 96.66666666666666
          }
        }
      ],
      "groups": [],
      "interactionBinding": {
        "npcDefinitionId": null
      }
    }
  ],
